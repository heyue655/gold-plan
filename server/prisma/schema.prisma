generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique @db.VarChar(50)
  email        String   @unique @db.VarChar(100)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  ssoUserId    Int?     @map("sso_user_id")
  createdAt    DateTime @default(now()) @map("created_at")

  plans         RepaymentPlan[]
  repayments    MonthlyRepayment[]
  ledgerEntries LedgerEntry[]

  sentBindings     FamilyBinding[] @relation("BindingRequester")
  receivedBindings FamilyBinding[] @relation("BindingReceiver")
  savingsGoals     SavingsGoal[]
  savingsPlans     SavingsPlan[]

  @@map("users")
}

model FamilyBinding {
  id          Int      @id @default(autoincrement())
  requesterId Int      @map("requester_id")
  receiverId  Int      @map("receiver_id")
  status      String   @default("PENDING") @db.VarChar(10) // PENDING | ACCEPTED | REJECTED
  createdAt   DateTime @default(now()) @map("created_at")

  requester User @relation("BindingRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  receiver  User @relation("BindingReceiver",  fields: [receiverId],  references: [id], onDelete: Cascade)

  @@unique([requesterId, receiverId])
  @@index([receiverId, status])
  @@map("family_bindings")
}

model LedgerEntry {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  type      String    @db.VarChar(10)  // INCOME or EXPENSE
  amount    Decimal   @db.Decimal(10, 2)
  category  String    @db.VarChar(50)
  note      String?   @db.VarChar(200)
  date      DateTime  @db.Date
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@map("ledger_entries")
}

model RepaymentPlan {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  name      String   @db.VarChar(100)
  amount    Decimal  @db.Decimal(10, 2)
  dueDay    Int      @map("due_day") @db.TinyInt
  repayType String   @default("MONTHLY") @map("repay_type") @db.VarChar(10) // ONCE | MONTHLY
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  repayments MonthlyRepayment[]

  @@index([userId])
  @@index([userId, isActive])
  @@map("repayment_plans")
}

model MonthlyRepayment {
  id        Int       @id @default(autoincrement())
  planId    Int       @map("plan_id")
  userId    Int       @map("user_id")
  year      Int       @db.SmallInt
  month     Int       @db.TinyInt
  amount    Decimal   @db.Decimal(10, 2)
  dueDate   DateTime  @map("due_date") @db.Date
  isPaid    Boolean   @default(false) @map("is_paid")
  paidAt    DateTime? @map("paid_at")
  isDeleted Boolean   @default(false) @map("is_deleted")
  createdAt DateTime  @default(now()) @map("created_at")

  plan RepaymentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([planId, year, month])
  @@index([userId, year, month])
  @@index([userId, isPaid])
  @@map("monthly_repayments")
}

model SavingsGoal {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  scope     String   @db.VarChar(10)  // PERSONAL | FAMILY
  year      Int      @db.SmallInt     // 目标年份
  amount    Decimal  @db.Decimal(12, 2)
  note      String?  @db.VarChar(200)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, scope, year])
  @@index([userId])
  @@map("savings_goals")
}

// ────── 留金执行计划（预算控制模型） ──────
model SavingsPlan {
  id                   Int      @id @default(autoincrement())
  userId               Int      @map("user_id")
  familyKey            String?  @db.VarChar(200) @map("family_key")
  scope                String   @db.VarChar(10)  // PERSONAL | FAMILY
  startDate            DateTime @map("start_date") @db.Date
  endDate              DateTime @map("end_date") @db.Date
  monthlyIncome        Decimal  @db.Decimal(12, 2) @map("monthly_income")
  monthlyRepayment     Decimal  @db.Decimal(12, 2) @map("monthly_repayment")
  savingsTarget        Decimal  @db.Decimal(12, 2) @map("savings_target")   // 留金目标
  monthlyBudget        Decimal  @db.Decimal(12, 2) @map("monthly_budget")   // = income - repayment - savings
  aiSummary            String   @db.Text @map("ai_summary")
  nonEssentialAnalysis String   @db.Text @map("non_essential_analysis") // JSON string
  status               String   @default("ACTIVE") @db.VarChar(12) // GENERATING | ACTIVE | COMPLETED | ABANDONED
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  weeks WeeklyTarget[]

  @@index([userId, status])
  @@map("savings_plans")
}

model WeeklyTarget {
  id              Int       @id @default(autoincrement())
  planId          Int       @map("plan_id")
  weekNumber      Int       @map("week_number") @db.SmallInt
  startDate       DateTime  @map("start_date") @db.Date
  endDate         DateTime  @map("end_date") @db.Date
  budgetAmount    Decimal   @db.Decimal(12, 2) @map("budget_amount")     // 本周可花预算
  actualSpending  Decimal?  @db.Decimal(12, 2) @map("actual_spending")   // 实际花费（实时算）
  status          String    @default("UPCOMING") @db.VarChar(12) // UPCOMING | IN_PROGRESS | UNDER_BUDGET | OVER_BUDGET
  aiAdvice        String    @db.Text @map("ai_advice")
  isAdjusted      Boolean   @default(false) @map("is_adjusted")
  originalBudget  Decimal?  @db.Decimal(12, 2) @map("original_budget")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  plan       SavingsPlan         @relation(fields: [planId], references: [id], onDelete: Cascade)
  reductions SpendingReduction[]

  @@index([planId, weekNumber])
  @@map("weekly_targets")
}

model SpendingReduction {
  id             Int      @id @default(autoincrement())
  weeklyTargetId Int      @map("weekly_target_id")
  category       String   @db.VarChar(50)
  description    String   @db.VarChar(500)
  weeklyLimit    Decimal  @db.Decimal(10, 2) @map("weekly_limit")
  actualSpent    Decimal? @db.Decimal(10, 2) @map("actual_spent")
  createdAt      DateTime @default(now()) @map("created_at")

  weeklyTarget WeeklyTarget @relation(fields: [weeklyTargetId], references: [id], onDelete: Cascade)

  @@index([weeklyTargetId])
  @@map("spending_reductions")
}

// AI 分析记录：familyKey 为家庭组 key（成员 id 排序后拼接），个人账号 familyKey = "u{userId}"
model AiAnalysisRecord {
  id          Int      @id @default(autoincrement())
  familyKey   String   @db.VarChar(200) @map("family_key") // e.g. "u1" or "u1_u3_u7"
  content     String   @db.Text                             // AI 分析全文
  netBalance  Decimal  @db.Decimal(12, 2) @map("net_balance") // 本次净留金（用于对比）
  totalIncome Decimal  @db.Decimal(12, 2) @map("total_income")
  totalExpense Decimal @db.Decimal(12, 2) @map("total_expense")
  totalRepayment Decimal @db.Decimal(12, 2) @map("total_repayment")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([familyKey, createdAt])
  @@map("ai_analysis_records")
}
